<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <!--
        BETA app id. Garmin requires a separate app id for beta uploads; before
        the public release, generate a new production id (uuidgen | tr -d -),
        put it here and upload without the "Beta App" option.
    -->
    <iq:application id="9b72dc026e2b407b92bf77a2a7c63d9d" type="datafield" version="0.1.0" name="@Strings.AppName" entry="EstimatedPowerApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <!--
            Current Edge models with Toybox.Weather (API 3.2.0+), each verified
            to compile with SDK 9.3.0. Older Edges (530, 830, 1030 family,
            Explore 2, MTB) and the Edge 1060 are deliberately not supported.
        -->
        <iq:products>
            <iq:product id="edge540"/>
            <iq:product id="edge550"/>
            <iq:product id="edge840"/>
            <iq:product id="edge850"/>
            <iq:product id="edge1040"/>
            <iq:product id="edge1050"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="FitContributor"/>
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
